// 自然观察时间线 · 数据模型
// 开发与测试使用 SQLite；生产可切换到 PostgreSQL（见 schema.postgres.prisma）。
// 枚举字段统一使用 String，避免两种数据库对 enum 的支持差异。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         String   @default("USER")
  timezone     String   @default("Asia/Shanghai")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  sites         Site[]
  species       Species[]
  observations  Observation[]
  tags          Tag[]
  shareLinks    ShareLink[]
  qualityReports QualityReport[]
  qualityFindings QualityFinding[]
  qualityActions QualityAction[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Site {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  latitude    Float?
  longitude   Float?
  elevationM  Int?
  habitat     String?
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  observations Observation[]
  shareLinks   ShareLink[]

  @@unique([ownerId, name])
  @@index([ownerId, archivedAt])
}

model Species {
  id             String    @id @default(cuid())
  ownerId        String?
  category       String
  commonName     String
  scientificName String?
  family         String?
  description    String?
  isPreset       Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phenophases  Phenophase[]
  observations Observation[]

  @@index([ownerId, category, commonName])
  @@index([category, commonName])
  @@index([isPreset])
}

model Phenophase {
  id         String  @id @default(cuid())
  speciesId  String
  name       String
  code       String?
  orderIndex Int     @default(0)
  color      String  @default("#3F6F52")
  isDefault  Boolean @default(false)

  species      Species       @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  observations Observation[]

  @@unique([speciesId, name])
  @@index([speciesId, orderIndex])
}

model Observation {
  id              String    @id @default(cuid())
  ownerId         String
  siteId          String
  speciesId       String?
  phenophaseId    String?
  kind            String
  status          String    @default("PUBLISHED")
  observationDate String
  observedAt      DateTime?
  title           String?
  notes           String?
  temperatureC    Float?
  precipitationMm Float?
  windLevel       Int?
  humidityPct     Int?
  anomalyType     String?
  anomalySeverity String?
  impactNotes     String?
  source          String    @default("MANUAL")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  site        Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  species     Species?          @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  phenophase  Phenophase?       @relation(fields: [phenophaseId], references: [id], onDelete: SetNull)
  photos      ObservationPhoto[]
  tags        ObservationTag[]

  @@index([ownerId, status, observationDate])
  @@index([siteId, speciesId, phenophaseId, observationDate])
  @@index([ownerId, kind, observationDate])
  @@index([siteId, observationDate])
}

model ObservationPhoto {
  id            String    @id @default(cuid())
  observationId String
  storageKey    String    @unique
  thumbKey      String
  displayKey    String
  originalName  String
  mimeType      String
  width         Int
  height        Int
  bytes         Int
  takenAt       DateTime?
  gpsStripped   Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId, sortOrder])
}

model Tag {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  color     String   @default("#B0793A")
  createdAt DateTime @default(now())

  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  observations ObservationTag[]

  @@unique([ownerId, name])
}

model ObservationTag {
  observationId String
  tagId         String

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([observationId, tagId])
  @@index([tagId])
}

model ShareLink {
  id        String    @id @default(cuid())
  token     String    @unique
  siteId    String
  ownerId   String
  scope     String    @default("TIMELINE")
  expiresAt DateTime
  revokedAt DateTime?
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())

  site  Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([siteId, revokedAt])
}

// 数据质量体检：一次扫描对应一份报告。报告本身是只读快照，处置动作写在 QualityAction。
model QualityReport {
  id          String    @id @default(cuid())
  ownerId     String
  rulesetVersion String @default("1.0.0")
  status      String    @default("COMPLETED")
  summary     String
  params      String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  owner    User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  findings QualityFinding[]

  @@index([ownerId, createdAt])
}

// 同一条问题（owner + fingerprint）全局唯一，跨报告复用；每次扫描只更新最新状态与分级，
// 因此分级建议可随时由同一套规则复算（rulesetVersion 标记规则版本）。
model QualityFinding {
  id           String   @id @default(cuid())
  ownerId      String
  reportId     String
  ruleCode     String
  category     String
  severity     String
  status       String   @default("OPEN")
  entityType   String
  entityId     String?
  storageKey   String?
  title        String
  detail       String
  evidence     String
  suggestion   String
  suggestedAction String
  fingerprint  String
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  resolvedAt   DateTime?
  dismissedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  report  QualityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actions QualityAction[]

  @@unique([ownerId, fingerprint])
  @@index([ownerId, status, severity])
  @@index([reportId])
  @@index([ownerId, ruleCode])
}

// 处置动作凭据：执行前留存 beforeSnapshot，回滚后留存 rollback 结果，全程可审计。
model QualityAction {
  id             String   @id @default(cuid())
  findingId      String
  ownerId        String
  action         String
  status         String   @default("APPLIED")
  params         String?
  beforeSnapshot String
  afterSnapshot  String?
  executedAt     DateTime @default(now())
  rolledBackAt   DateTime?
  rollbackResult String?
  createdAt      DateTime @default(now())

  finding QualityFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  owner   User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@index([ownerId, executedAt])
}
